# Required security secret. Generate your own long random value.
ARIA2_RPC_SECRET=replace-with-at-least-32-random-characters

# GitHub Pages origin allowed to call the API.
FRONTEND_ORIGIN=https://matthewcodergamer.github.io

# MAX SPEED profile. aria2 itself does not impose a download cap.
ARIA2_HTTP_CONNECTIONS=16
ARIA2_SPLIT=16
ARIA2_MIN_SPLIT_SIZE=1M
ARIA2_BT_MAX_PEERS=200
ARIA2_DISK_CACHE=512M
# none is the safest default for Codespaces/container storage; dedicated VMs may use falloc.
ARIA2_FILE_ALLOCATION=none
ARIA2_MAX_CONCURRENT_DOWNLOADS=8

# Keep some upload headroom so BitTorrent upload does not choke downloads.
ARIA2_MAX_OVERALL_UPLOAD_LIMIT=2M
ARIA2_BT_UPLOAD_LIMIT=2M
ARIA2_IPV6_MODE=false
